generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Trend {
  id              String   @id @default(cuid())
  keyword         String
  country         String
  category        String   // Obituary, Accident, Celebrity Death, etc.
  trendScore      Float
  searchVolume    String?
  source          String
  publishedAt     DateTime @default(now())
  breakoutStatus  String?  // BREAKOUT, TRENDING, HOT, VIRAL, RISING FAST
  velocity        Float    @default(0)
  region          String?
  relatedQueries  String[]
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([keyword])
  @@index([country])
  @@index([category])
  @@index([breakoutStatus])
}

model Alert {
  id          String   @id @default(cuid())
  type        String   // BROWSER, SOUND, TELEGRAM, EMAIL, WEBHOOK
  message     String
  severity    String   @default("INFO") // INFO, WARNING, CRITICAL
  trendId     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Source {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   // RSS, NEWS, GOOGLE_TRENDS, SCRAPER
  isActive  Boolean  @default(true)
  lastScraped DateTime?
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // ADMIN, VIEWER
  createdAt DateTime @default(now())
}

model GeneratedContent {
  id          String   @id @default(cuid())
  trendId     String
  title       String
  content     String   @db.Text
  type        String   // SUMMARY, NEWS, BLOG, SEO
  metaDesc    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
